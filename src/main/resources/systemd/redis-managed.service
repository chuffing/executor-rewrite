[Unit]
Description=Managed Redis Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=__CURRENT_DIR__/bin/redis-server __REDIS_CONFIG_FILE__ --daemonize no --supervised no
Restart=on-failure
RestartSec=5
SuccessExitStatus=0 143
TimeoutStopSec=30
LimitNOFILE=10032

[Install]
WantedBy=multi-user.target
